[Unit]
Description=rsbtd torrent daemon
Documentation=https://github.com/namazso/rsbtd
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/rsbtd --config /etc/rsbtd/rsbtd.toml
Restart=on-failure

# SIGTERM triggers a graceful shutdown (resume-data flush, tracker
# goodbyes); give it time before SIGKILL.
TimeoutStopSec=45

User=rsbtd
Group=rsbtd
StateDirectory=rsbtd
RuntimeDirectory=rsbtd

# Hardening. Adjust ReadWritePaths to your download locations.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rsbtd
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
